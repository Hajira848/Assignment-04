@page "/todolist"
@using Application_03.Models
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0">Application 3: To-Do List</h3>
                </div>

                <div class="card-body p-4">
                    <div class="input-group mb-4 shadow-sm">
                        <input type="text"
                               class="form-control form-control-lg"
                               placeholder="Enter a new task..."
                               @bind="App.NewTaskTitle"
                               @bind:event="oninput"
                               @onkeyup="App.HandleKeyPress" />
                        <button class="btn btn-success btn-lg px-4" @onclick="App.AddTask">
                            <i class="bi bi-plus-circle-fill me-1"></i> Add
                        </button>
                    </div>

                    @if (App.TasksList.Count > 0)
                    {
                        <div class="text-end mb-3">
                            <button class="btn btn-outline-danger btn-sm shadow-sm" @onclick="App.ClearAllTasks">
                                <i class="bi bi-trash3-fill me-1"></i> Clear All Tasks
                            </button>
                        </div>
                    }

                    <div class="mt-2">
                        @if (App.TasksList.Count == 0)
                        {
                            <div class="text-center text-muted my-4 py-3 bg-light rounded border border-dashed">
                                <i class="bi bi-clipboard-x fs-2 d-block mb-2 text-secondary"></i>
                                <span>No tasks added yet. Type above to add a task!</span>
                            </div>
                        }
                        else
                        {
                            <ul class="list-group shadow-sm">
                                @foreach (var task in App.TasksList)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                        @if (task.IsEditing)
                                        {
                                            <div class="input-group input-group-sm w-100">
                                                <input type="text" class="form-control" @bind="task.EditText" />
                                                <button class="btn btn-success" @onclick="() => App.SaveEdit(task)">
                                                    <i class="bi bi-check-lg"></i> Save
                                                </button>
                                                <button class="btn btn-secondary" @onclick="() => App.CancelEdit(task)">
                                                    <i class="bi bi-x-lg"></i> Cancel
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-arrow-right-short text-success fs-4 me-2"></i>
                                                <span class="fs-5">@task.Title</span>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => App.StartEdit(task)">
                                                    <i class="bi bi-pencil-fill"></i> Edit
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => App.DeleteTask(task)">
                                                    <i class="bi bi-trash-fill"></i> Delete
                                                </button>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private TodoAppEngine App = new TodoAppEngine();
}

