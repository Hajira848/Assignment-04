@page "/counterportal"
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">Application 4: Hybrid Counter</h3>
                </div>

                <div class="card-body p-4 text-center">

                    <div class="bg-light rounded p-4 mb-4 border border-primary-subtle shadow-sm">
                        <p class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.85rem; 
                         letter-spacing: 1px;">Current Click Count</p>
                        <h1 class="display-1 text-primary fw-bold my-0">@currentCount</h1>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <button class="btn btn-primary btn-lg py-3 shadow-sm text-uppercase fw-bold" @onclick=
                        "IncrementCount">
                            <i class="bi bi-plus-circle me-2"></i> Click to Increment
                        </button>
                    </div>

                    <hr class="text-muted my-4" />

                    <div class="bg-light-subtle rounded p-3 border border-dashed text-start">
                        <label for="manualInput" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-sliders me-1"></i> Manually Adjust Count:
                        </label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-secondary">
                                <i class="bi bi-pencil-square"></i>
                            </span>
                            <input type="number"
                                   id="manualInput"
                                   class="form-control form-control-lg text-center"
                                   @bind="currentCount"
                                   @bind:event="oninput"
                                   placeholder="Type a number..." />
                        </div>
                        <div class="form-text text-muted mt-2">
                            Changing this input box updates the large counter box live above using two-way binding.
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private int currentCount = 0;
    private void IncrementCount()
    {
        currentCount++;
    }
}

