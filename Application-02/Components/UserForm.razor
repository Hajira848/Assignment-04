@page "/userform"
@using Application_02.Models
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">Application 2: Registration Form</h3>
                </div>
                <div class="card-body p-4">

                    @if (showSuccessMessage)
                    {
                        <div class="alert alert-success d-flex align-items-center shadow-sm" role="alert">
                            <span class="bi bi-check-circle-fill me-2 fs-5"></span>
                            <div>
                                <strong>Success!</strong> Form submitted successfully for @submittedUserEmail.
                            </div>
                        </div>
                    }

                    <EditForm Model="@user" OnValidSubmit="HandleValidSubmit" FormName="RegistrationForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">First Name:</label>
                            <InputText class="form-control" placeholder="Enter first name" @bind-Value="user.FirstName" />
                            <div class="text-danger small mt-1">
                                <ValidationMessage For="@(() => user.FirstName)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Last Name:</label>
                            <InputText class="form-control" placeholder="Enter last name" @bind-Value="user.LastName" />
                            <div class="text-danger small mt-1">
                                <ValidationMessage For="@(() => user.LastName)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address:</label>
                            <InputText class="form-control" placeholder="user@example.com" @bind-Value="user.Email" />
                            <div class="text-danger small mt-1">
                                <ValidationMessage For="@(() => user.Email)" />
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Submit Registration
                            </button>
                        </div>
                    </EditForm>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserModel user = new UserModel();
    private bool showSuccessMessage = false;
    private string submittedUserEmail = string.Empty;

    private void HandleValidSubmit()
    {
        submittedUserEmail = user.Email;
        showSuccessMessage = true;
        user = new UserModel();
    }
}
