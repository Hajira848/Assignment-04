@page "/notifications"
@using Application_06.Services
@inject NotificationService NotifyService
@inject NotificationConfig Config
@implements IDisposable
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2><i class="bi bi-bell-fill text-warning me-2"></i>User Dashboard Central Matrix</h2>
        <span class="badge bg-secondary p-2 fs-6">
            Current Profile Mode: @Config.NotificationStyle View
        </span>
    </div>

    @if (notifications == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Fetching centralized logs asynchronously...</p>
        </div>
    }
    else if (notifications.Count == 0)
    {
        <div class="alert alert-info shadow-sm">No notification alerts discovered inside system index buffer logs.</div>
    }
    else
    {
        <div class="row">
            @foreach (var alert in notifications)
            {
                if (Config.NotificationStyle == "Compact")
                {
                    <div class="col-12 mb-2">
                        <div class="p-2 bg-light border-start border-3 border-info d-flex align-items-center shadow-sm">
                            <i class="bi bi-info-circle-fill text-info me-2"></i>
                            <span class="text-truncate" style="max-width: 85%;">@alert.Substring(0, Math.Min(35, alert.Length))...</span>
                            <span class="ms-auto badge bg-dark-subtle text-dark-emphasis small">System Static</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 mb-3">
                        <div class="card border-0 shadow-sm bg-white border-start border-4 border-primary">
                            <div class="card-body d-flex align-items-start">
                                <i class="bi bi-envelope-paper-fill text-primary fs-3 me-3 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold mb-1">Automated Core Core Infrastructure Log</h6>
                                    <p class="text-muted mb-0 small">@alert</p>
                                    <span class="text-black-50 d-block mt-2" style="font-size: 11px;">
                                        <i class="bi bi-clock me-1"></i> Timestamp Trace: Operational @DateTime.Now.ToShortTimeString()
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<string>? notifications;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertData();
        Config.OnConfigChanged += RefreshView;
    }

    private async Task LoadAlertData()
    {
        notifications = await NotifyService.GetNotificationsAsync();
    }

    private async void RefreshView()
    {
        await LoadAlertData();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Config.OnConfigChanged -= RefreshView;
    }
}
