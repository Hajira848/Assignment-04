@page "/settings"
@using Application_06.Services
@inject NotificationConfig Config
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
            <h4 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Global Notification Configuration Panel</h4>
        </div>
        <div class="card-body p-4">

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Default Alert Display Limit</label>
                <input type="number" class="form-control form-control-lg"
                       @bind="Config.DefaultNumberOfNotifications" min="1" max="10" />
                <div class="form-text">Configure how many notifications are fetched automatically
                    inside dashboard.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">Visual Presentation Style Layout</label>
                <select class="form-select form-control-lg" @bind="Config.NotificationStyle">
                    <option value="Compact">Compact Display Matrix</option>
                    <option value="Detailed">Detailed Information Card</option>
                </select>
            </div>

            <button class="btn btn-primary btn-lg px-4 shadow-sm" @onclick="SaveChanges">
                <i class="bi bi-check-circle-fill me-2"></i> Apply Layout Configurations
            </button>

        </div>
    </div>
</div>

@code {
    private void SaveChanges()
    {
        Config.NotifyChanged();
    }
}
