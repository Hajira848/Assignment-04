@page "/"
@rendermode InteractiveServer

<PageTitle>Home - Notification Hub</PageTitle>

<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-2">
            <h1 class="display-5 fw-bold text-dark">
                <i class="bi bi-cpu-fill text-primary me-2"></i>Application 06 Dashboard
            </h1>
            <p class="col-md-8 fs-5 text-secondary">
                Welcome to the Configurable Notification Service Portal. This system utilizes dependency injection
                to seamlessly manage global runtime configurations and deliver live notifications dynamically across different UI view matrices.
            </p>
            <hr class="my-4">
            <p class="small text-muted">Framework Context: Blazor Interactive Server Pipeline Core (.NET 9 Architecture)</p>
        </div>
    </div>

    <div class="row align-items-stretch">

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-gear-fill text-primary display-6 me-3"></i>
                        <h4 class="card-title fw-bold mb-0">System Configurations</h4>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Modify the default alert rendering thresholds and customize global presentation view layouts between compact listing modes or detailed informational view templates.
                    </p>
                    <a href="settings" class="btn btn-primary mt-3 px-4 py-2 fw-semibold shadow-sm w-100">
                        <i class="bi bi-sliders me-2"></i>Open Service Settings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-bell-fill text-warning display-6 me-3"></i>
                        <h4 class="card-title fw-bold mb-0">Live Notifications Center</h4>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        View simulated background system log alerts fetched asynchronously. The component layout automatically re-renders dynamically based on your chosen configuration style.
                    </p>
                    <a href="notifications" class="btn btn-outline-warning text-dark mt-3 px-4 py-2 fw-semibold shadow-sm w-100" style="background-color: #fff3cd; border-color: #ffe69c;">
                        <i class="bi bi-eye-fill me-2"></i>View System Alerts
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>